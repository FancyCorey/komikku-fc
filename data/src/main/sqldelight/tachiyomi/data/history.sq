import java.util.Date;

CREATE TABLE history(
    _id INTEGER NOT NULL PRIMARY KEY,
    chapter_id INTEGER NOT NULL UNIQUE,
    last_read INTEGER AS Date,
    time_read INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

CREATE INDEX history_history_chapter_id_index ON history(chapter_id);
CREATE INDEX idx_history_last_read ON history(last_read) WHERE last_read > 0;

getHistoryByMangaId:
SELECT
H._id,
H.chapter_id,
H.last_read,
H.time_read
FROM history H
JOIN chapters C
ON H.chapter_id = C._id
WHERE C.manga_id = :mangaId AND C._id = H.chapter_id;

getHistoryByChapterUrl:
SELECT
H._id,
H.chapter_id,
H.last_read,
H.time_read
FROM history H
JOIN chapters C
ON H.chapter_id = C._id
WHERE C.manga_id = :mangaId AND C.url = :chapterUrl AND C._id = H.chapter_id;

-- KMK -->
resetHistoryByIds:
-- KMK <--
UPDATE history
SET last_read = 0
-- KMK -->
WHERE _id IN :historyIds;

resetHistoryByMangaIds:
-- KMK <--
UPDATE history
SET last_read = 0
WHERE _id IN (
    SELECT H._id
    FROM mangas M
    INNER JOIN chapters C
    ON M._id = C.manga_id
    INNER JOIN history H
    ON C._id = H.chapter_id
    -- KMK -->
    WHERE M._id IN :mangaIds
-- KMK <--
);

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE last_read = 0;

upsert:
INSERT INTO history(chapter_id, last_read, time_read)
VALUES (:chapterId, :readAt, :time_read)
ON CONFLICT(chapter_id)
DO UPDATE
SET
    last_read = :readAt,
    time_read = time_read + :time_read
WHERE chapter_id = :chapterId;

getReadDuration:
SELECT coalesce(sum(time_read), 0)
FROM history;

-- KMK --> v0.8.24 recent-reading profile (read-only; no schema change)
-- One row per manga with at least one chapter whose last read is inside the window. A chapter counts as read when
-- it is marked read or has reading time. `history` keeps one row per chapter, so active_days counts distinct local
-- days of those last reads, not opens.
getRecentReadingActivity:
SELECT
C.manga_id AS manga_id,
COUNT(DISTINCT C._id) AS chapters_read,
COUNT(DISTINCT strftime('%Y-%m-%d', CAST(H.last_read AS INTEGER) / 1000, 'unixepoch', 'localtime')) AS active_days,
CAST(MAX(H.last_read) AS INTEGER) AS last_read_at,
(SELECT COUNT(*) FROM chapters X WHERE X.manga_id = C.manga_id) AS total_chapters
FROM history H
JOIN chapters C
ON C._id = H.chapter_id
WHERE H.last_read > 0
AND CAST(H.last_read AS INTEGER) >= :sinceMillis
AND (H.time_read > 0 OR C.read = 1)
GROUP BY C.manga_id;
-- KMK <--
