<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="app.komikku.kmk" />
    </queries>

    <application>
        <service
            android:name="eu.kanade.tachiyomi.data.updater.PackageInstallerCallbackObserverService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:process=":kmk_b8_installer_observer">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Test-only observer for a user-initiated package installation callback" />
        </service>
    </application>

</manifest>
